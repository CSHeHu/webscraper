# Maintainer: Heikki Huttu <heissendo88@gmail.com>
pkgname=newscraper
pkgver=TODO
pkgrel=TODO
pkgdesc="Qt desktop app for reading news headlines from RSS feeds"
arch=('x86_64')
url="https://github.com/CSHeHu/newscraper"
license=('MIT')
depends=('qt6-base' 'gcc-libs' 'glibc')
makedepends=('cmake')
backup=('etc/newscraper/config.json')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  local cmake_args=(
    -B build
    -S "$pkgname-$pkgver"
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/usr
    -Wno-dev
  )

  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" \
    -t "$pkgdir/usr/share/licenses/$pkgname/"
}
